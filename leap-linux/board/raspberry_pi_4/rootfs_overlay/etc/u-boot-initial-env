stdin=serial,usbkbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootm_size=0x20000000

kernel_addr_r=0x00080000
kernel_comp_addr_r=0x02000000
kernel_comp_size=0x03400000
scriptaddr=0x05400000
pxefile_addr_r=0x05500000
fdt_addr_r=0x05600000
ramdisk_addr_r=0x05700000

boot_targets=mmc

ustate=0
boot_retries=0
max_boot_retries=5
boot_slot=a

set_bootpart=if test "${boot_slot}" = "a"; then setenv bootpart 3; else setenv bootpart 4; fi
reset_bootpart=setenv bootpart

boot_slot_cmd=run set_bootpart; if part uuid mmc 0:${bootpart} rootpartuuid; then sysboot mmc 0:${bootpart} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf; fi; run reset_bootpart

swap_boot_slot=if test "${boot_slot}" = "a"; then setenv boot_slot b; else setenv boot_slot a; fi; saveenv

boot_selected_slot=echo "Booting from slot ${boot_slot}..."; run boot_slot_cmd
boot_alternate_slot=echo "Boot process for slot ${boot_slot} failed too many times."; setenv ustate 3; setenv boot_retries 0; run swap_boot_slot; echo "Falling back to slot ${boot_slot}"; run boot_slot_cmd

incr_boot_count=if test ${ustate} -eq 1; then setexpr boot_retries ${boot_retries} + 1; saveenv; fi

bootcmd=if test ${ustate} -ne 1 -o ${boot_retries} -lt ${max_boot_retries}; then run incr_boot_count; run boot_selected_slot; else run boot_alternate_slot; fi
